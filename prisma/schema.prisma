generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Cabinet {
  conseil
  expertise_fiscale
}

enum DocumentType {
  quotation
  invoice
  letter
}

enum DocumentStatus {
  draft
  signed
  sent
  accepted
  rejected
  paid
  overdue
  archived
  cancelled
}

enum PaymentMethod {
  cash
  check
  bank_transfer
}

/** Profil de facturation du client. */
enum ClientBillingProfile {
  subscription
  one_off
  mixed
}

/** Pôle métier du client / du document. */
enum ClientPole {
  formation
  audit
  juridique
  comptabilite
}

enum ActivityKind {
  invoice_paid
  invoice_sent
  invoice_overdue
  quotation_accepted
  quotation_sent
  client_added
}

enum NotificationType {
  info
  success
  warning
  danger
}

enum MailDirection {
  outbound
  inbound
}

enum DocumentPdfAction {
  download
  email
}

enum DocumentExportStatus {
  pending
  processing
  completed
  failed
}

enum DocumentExportFormat {
  zip
  csv
  both
}

enum StaffRole {
  member
  admin
  super_admin
}

/** Espaces applicatifs autorisés pour ce collaborateur. */
enum StaffSpacesAllowed {
  facturation
  prospection
  both
}

enum AdminRequestStatus {
  pending
  accepted
  rejected
}

enum MailMergeStatus {
  draft
  pending_signature
  signed
  sent
}

model Company {
  id          String   @id @default(cuid())
  cabinet     Cabinet  @unique
  name        String
  tagline     String?
  nif         String
  niu         String
  rccm        String
  cnss        String?
  address     String
  city        String
  phone       String
  email       String
  website     String?
  bankName    String?
  bankAccount String?
  /** Adresse From Resend (domaine vérifié). Si vide → email du cabinet. */
  mailFromEmail String?
  /** Reply-To. Si vide → mailFromEmail / email. */
  mailReplyTo   String?
  /** Nom du gérant (signataire des lettres). */
  managerName String?
  /** E-mail du gérant (mis en CC des envois clients). */
  managerEmail String?
  /** URL publique du cachet / tampon (Storage ou asset). */
  stampUrl    String?
  /** Couleur primaire de l’interface (hex, ex. #1E40AF). */
  primaryColor String?
  /** Modèles d’e-mails de relance (JSON : { "15"|"20"|"25": { subject, intro } }). */
  reminderTemplates Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

model StaffMember {
  id        String    @id
  email     String    @unique
  firstName String
  lastName  String
  jobTitle  String
  phone     String?
  avatarUrl String?
  role      StaffRole @default(member)
  /// Null uniquement pour super_admin (au-dessus des cabinets).
  cabinet   Cabinet?
  /// Conservé à la promotion admin (visibilité cabinet entière). Null pour super_admin.
  pole      ClientPole?
  /// Facturation / Prospection / les deux (super_admin = both).
  spacesAllowed StaffSpacesAllowed @default(facturation)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents     Document[]
  clients       Client[]
  services      Service[]
  notifications Notification[]
  adminRequests AdminRequest[] @relation("AdminRequestStaff")
  reviewedRequests AdminRequest[] @relation("AdminRequestReviewer")
  pdfTraces     DocumentPdfTrace[]
  mailMergeCampaigns MailMergeCampaign[] @relation("MailMergeCreator")
  mailMergeSigned    MailMergeCampaign[] @relation("MailMergeSigner")
  mailMergeSignatureRequests MailMergeCampaign[] @relation("MailMergeSignatureRequester")
  letterSignatureRequests LetterSignatureRequest[] @relation("LetterSignatureRequester")
  letterSignatureReviews  LetterSignatureRequest[] @relation("LetterSignatureReviewer")
  documentExportJobs      DocumentExportJob[]
  crmCompanies  CrmCompany[]

  @@index([lastName])
  @@index([role])
  @@index([cabinet])
  @@index([pole])
  @@index([cabinet, pole])
  @@index([spacesAllowed])
  @@map("staff_members")
}

/** Comptes retirés de la plateforme (login → page « compte supprimé »). */
model RevokedAccount {
  id         String   @id @default(cuid())
  email      String   @unique
  authUserId String?
  revokedAt  DateTime @default(now())
  revokedById String?

  @@index([authUserId])
  @@map("revoked_accounts")
}

model AdminRequest {
  id           String             @id @default(cuid())
  staffId      String
  status       AdminRequestStatus @default(pending)
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  staff      StaffMember  @relation("AdminRequestStaff", fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy StaffMember? @relation("AdminRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([staffId, status])
  @@index([status, createdAt])
  @@map("admin_requests")
}

model Client {
  id          String   @id @default(cuid())
  cabinet     Cabinet
  name        String
  /// Sigle / abréviation (fiche ANPI).
  sigle       String   @default("")
  legalForm   String
  /// Capital social (texte libre, ex. « 10 000 000 FCFA »).
  shareCapital String @default("")
  /// Identifiant métier affiché sur factures / devis (ex. DNC 025).
  clientRef   String @default("")
  nif         String
  niu         String
  rccm        String
  cnss        String   @default("")
  cnamgs      String   @default("")
  /// Activité principale (fiche ANPI).
  activity    String   @default("")
  /// Nature détaillée de l’activité.
  activityDetail String @default("")
  /// Représentant légal (nom).
  contactName String
  /// Qualité du représentant (ex. Gérant).
  representativeTitle String @default("")
  email       String
  phone       String
  address     String
  /// Boîte postale (affichée sur les courriels à la place du quartier).
  bp          String   @default("")
  city        String
  country     String   @default("Gabon")
  /// N° fiche ANPI (optionnel).
  anpiNumber  String   @default("")
  /// Date de la fiche ANPI (texte, ex. 22/03/2022).
  anpiDate    String   @default("")
  /** Destinataire ponctuel (publipostage) — masqué de la liste clients. */
  isTransient Boolean  @default(false)
  /** Abonnement / ponctuel / les deux. */
  billingProfile ClientBillingProfile @default(mixed)
  /** Pôle métier (formation, audit, juridique, comptabilité). */
  pole          ClientPole @default(formation)
  /** URL publique fiche circuit (Storage). */
  ficheCircuitUrl  String?
  ficheCircuitName String?
  /** URL publique fiche status (Storage). */
  ficheStatusUrl   String?
  ficheStatusName  String?
  /** Collaborateur ayant créé la fiche (null = historique). */
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  exportJobs DocumentExportJob[]
  paymentReminderLogs PaymentReminderLog[]
  createdBy StaffMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  crmCompany CrmCompany?

  @@index([cabinet])
  @@index([name])
  @@index([city])
  @@index([createdById])
  @@index([billingProfile])
  @@index([pole])
  @@index([cabinet, pole])
  @@map("clients")
}

model Service {
  id          String   @id @default(cuid())
  cabinet     Cabinet
  code        String
  name        String
  description String   @default("")
  unit        String
  unitPrice   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  category    String
  /** Collaborateur ayant créé la prestation (null = historique / seed). */
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     DocumentLine[]
  createdBy StaffMember?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([cabinet, code])
  @@index([cabinet])
  @@index([category])
  @@index([createdById])
  @@map("services")
}

model Document {
  id                String         @id @default(cuid())
  cabinet           Cabinet
  type              DocumentType
  number            String
  clientId          String
  createdById       String
  /** Pôle métier du document (prérempli depuis le client, modifiable). */
  pole              ClientPole     @default(formation)
  status            DocumentStatus @default(draft)
  issueDate         DateTime       @db.Date
  /** Optionnel — si null, aucune échéance affichée sur facture / devis. */
  dueDate           DateTime?      @db.Date
  subtotal          Decimal        @db.Decimal(18, 2)
  /** Remise globale % sur le HT taxable (factures / devis). */
  discount          Decimal        @default(0) @db.Decimal(5, 2)
  /** percent | amount — remise en % ou forfait XAF (2R Conseil). */
  discountMode      String         @default("percent")
  /** Montant forfaitaire de la remise (XAF) quand discountMode = amount. */
  discountFixed     Decimal        @default(0) @db.Decimal(18, 2)
  tps               Decimal        @default(0) @db.Decimal(18, 2)
  css               Decimal        @default(0) @db.Decimal(18, 2)
  vat               Decimal        @db.Decimal(18, 2)
  total             Decimal        @db.Decimal(18, 2)
  currency          String         @default("XAF")
  notes             String?
  paymentTerms      String?
  /** Afficher le bloc RIB (coordonnées bancaires société) sur le document. */
  showRib           Boolean        @default(false)
  /** Moyen de règlement lorsque status = paid. */
  paymentMethod     PaymentMethod?
  validityDays      Int?
  executionTerms    String?
  subject           String?
  salutation        String?
  body              String?
  closing           String?
  signatoryTitle    String?
  recipientOverride String?
  /** Ville d’émission du courrier (ex. Libreville), pour « Libreville, le … ». */
  placeCity         String?
  /** Facture modèle d'abonnement mensuel. */
  isSubscription       Boolean   @default(false)
  subscriptionActive   Boolean   @default(false)
  /** Jour du mois d'envoi (1–28). */
  subscriptionDay      Int?
  subscriptionNextAt   DateTime? @db.Date
  /** Jour d'échéance sur les factures générées (null = même jour que l'émission). */
  subscriptionDueDay           Int?
  /** Mois entre émission et échéance (défaut 1 → ex. 5 au 5 du mois suivant). */
  subscriptionDueMonthsOffset  Int       @default(1)
  /** Facture générée depuis un abonnement (id du modèle). */
  subscriptionOfId     String?
  /** Suffixer les désignations avec « échéances du mois de … ». */
  showDueMonthOnLines  Boolean   @default(false)
  /** Papier 2R Conseil : masquer qté / P.U. HT / total nuls. */
  hideZeroLineFigures  Boolean   @default(true)
  /** Ajustement manuel du TTC (XAF, positif = ajouter, négatif = retirer). */
  totalRounding        Int       @default(0)
  /** Acompte déjà versé (XAF), déduit du TTC — factures 2R Conseil. */
  deposit              Decimal   @default(0) @db.Decimal(18, 2)
  /** Campagne de publipostage (lettres groupées). */
  mailMergeCampaignId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy     StaffMember    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  subscriptionOf Document?     @relation("SubscriptionGenerations", fields: [subscriptionOfId], references: [id], onDelete: SetNull)
  subscriptionChildren Document[] @relation("SubscriptionGenerations")
  mailMergeCampaign MailMergeCampaign? @relation(fields: [mailMergeCampaignId], references: [id], onDelete: SetNull)
  lines         DocumentLine[]
  sections      DocumentSection[]
  notifications Notification[]
  pdfTraces     DocumentPdfTrace[]
  signatureRequests LetterSignatureRequest[]

  @@unique([cabinet, type, number])
  @@index([cabinet])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([issueDate])
  @@index([isSubscription, subscriptionActive, subscriptionNextAt])
  @@index([subscriptionOfId])
  @@index([mailMergeCampaignId])
  @@index([pole])
  @@index([cabinet, pole])
  @@map("documents")
}

/** Section / tâche optionnelle regroupant des lignes (facture / devis structurés). */
model DocumentSection {
  id         String @id @default(cuid())
  documentId String
  title      String
  position   Int    @default(0)

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lines    DocumentLine[]

  @@index([documentId])
  @@map("document_sections")
}

model DocumentLine {
  id          String  @id @default(cuid())
  documentId  String
  sectionId   String?
  serviceId   String?
  description String
  /** service = honoraires ; funds = fonds de procédures hors taxe (2R Conseil). */
  billingKind String  @default("service")
  quantity    Decimal @db.Decimal(18, 3)
  /** quantity | month | year | none — mois/année = même calcul que quantité. */
  quantityUnit String @default("quantity")
  /** 2R Conseil : masquer P.U. HT et total HT s’ils sont nuls. */
  hideZeroFigures Boolean @default(true)
  unitPrice   Decimal @db.Decimal(18, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  tpsRate     Decimal @default(0) @db.Decimal(5, 2)
  cssRate     Decimal @default(0) @db.Decimal(5, 2)
  position    Int     @default(0)

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section  DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  service  Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([sectionId])
  @@index([serviceId])
  @@map("document_lines")
}

model Activity {
  id          String       @id @default(cuid())
  kind        ActivityKind
  title       String
  description String
  at          DateTime     @default(now())

  @@index([at])
  @@map("activities")
}

model Notification {
  id         String           @id @default(cuid())
  staffId    String
  title      String
  body       String
  at         DateTime         @default(now())
  read       Boolean          @default(false)
  type       NotificationType @default(info)
  documentId String?
  /// Cabinet concerné (filtre super admin = cabinet actif).
  cabinet    Cabinet?

  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([staffId, read])
  @@index([staffId, at])
  @@index([staffId, cabinet, at])
  @@map("notifications")
}

/** Demande de signature électronique (étape A : cachet cabinet + validation admin). */
model LetterSignatureRequest {
  id            String             @id @default(cuid())
  documentId    String
  cabinet       Cabinet
  status        AdminRequestStatus @default(pending)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy StaffMember @relation("LetterSignatureRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  StaffMember? @relation("LetterSignatureReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([documentId, status])
  @@index([cabinet, status, createdAt])
  @@index([requestedById])
  @@map("letter_signature_requests")
}

/** Campagne de publipostage lettres (création → signature → envoi). */
model MailMergeCampaign {
  id             String          @id @default(cuid())
  cabinet        Cabinet
  createdById    String
  status         MailMergeStatus @default(draft)
  subject        String
  salutation     String          @default("")
  body           String
  closing        String          @default("")
  signatoryTitle String          @default("Le Gérant")
  issueDate      DateTime        @db.Date
  signedAt       DateTime?
  signedById     String?
  /** Demande de signature en attente (membre → admin). */
  signatureRequestedAt   DateTime?
  signatureRequestedById String?
  signatureRejectedAt    DateTime?
  signatureRejectNote    String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy StaffMember  @relation("MailMergeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signedBy  StaffMember? @relation("MailMergeSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signatureRequestedBy StaffMember? @relation("MailMergeSignatureRequester", fields: [signatureRequestedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([cabinet, createdAt])
  @@index([status])
  @@index([createdById])
  @@map("mail_merge_campaigns")
}

/** Historique des e-mails envoyés / reçus (espace Mails). */
model MailMessage {
  id         String        @id @default(cuid())
  cabinet    Cabinet?
  direction  MailDirection
  resendId   String?       @unique
  fromEmail  String
  toEmail    String
  /** Destinataires en copie (CC), séparés par virgule si plusieurs. */
  ccEmail    String?
  subject    String
  preview    String        @default("")
  htmlBody   String?
  textBody   String?
  documentId String?
  clientId   String?
  staffId    String?
  lastEvent  String?
  createdAt  DateTime      @default(now())

  @@index([cabinet, direction, createdAt])
  @@index([direction, createdAt])
  @@map("mail_messages")
}

/** Trace PDF généré (téléchargement ou envoi e-mail). */
model DocumentPdfTrace {
  id         String            @id @default(cuid())
  documentId String
  cabinet    Cabinet
  action     DocumentPdfAction
  fileName   String
  fileUrl    String
  staffId    String
  createdAt  DateTime          @default(now())

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([cabinet, createdAt])
  @@index([staffId])
  @@map("document_pdf_traces")
}

/** Relance de paiement envoyée (clients abonnement). */
model PaymentReminderLog {
  id          String   @id @default(cuid())
  cabinet     Cabinet
  clientId    String
  /** Palier : 15, 20 ou 25 du mois. */
  reminderDay Int
  /** Mois civil de l'envoi (YYYY-MM). */
  periodMonth String
  toEmail     String
  documentIds String[]
  totalAmount Decimal  @db.Decimal(18, 2)
  sentAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, reminderDay, periodMonth])
  @@index([cabinet, sentAt])
  @@index([clientId, sentAt])
  @@map("payment_reminder_logs")
}

/** Export groupé (ZIP / CSV) pour l'espace Bilan admin. */
model DocumentExportJob {
  id           String               @id @default(cuid())
  cabinet      Cabinet
  createdById  String
  status       DocumentExportStatus @default(pending)
  format       DocumentExportFormat
  /// null = tous les types
  documentType DocumentType?
  clientId     String?
  months       Int
  dateFrom     DateTime             @db.Date
  dateTo       DateTime             @db.Date
  progress     Int                  @default(0)
  total        Int                  @default(0)
  zipUrl       String?
  zipPath      String?
  csvUrl       String?
  csvPath      String?
  skippedCount Int                  @default(0)
  errorMessage String?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  createdBy StaffMember @relation(fields: [createdById], references: [id], onDelete: Restrict)
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([cabinet, createdAt])
  @@index([createdById, createdAt])
  @@index([status])
  @@map("document_export_jobs")
}

// ─── Prospection / CRM (espace séparé de la Facturation) ───────────────────

enum CrmCompanyKind {
  prospect
  client
}

enum CrmSite {
  libreville
  port_gentil
  franceville
}

enum CrmServiceLine {
  rh
  comptabilite
  conseil
  fiscalite
  formation
}

enum CrmOpportunitySource {
  nouveau
  client_existant
  client_formation
  piste_interne
}

enum CrmPipelineStage {
  qualification
  premier_contact
  rendez_vous
  proposition
  negotiation
  decision
  gagne
  perdu
  reporte
}

enum CrmActivityKind {
  appel
  email
  visite
  rdv
  evenement
}

enum CrmActivityStatus {
  a_faire
  planifiee
  en_cours
  terminee
  annulee
  en_retard
}

enum CrmLeadStatus {
  nouvelle
  en_cours
  qualifiee
  convertie
  rejetee
  reportee
}

enum CrmContactInfluence {
  faible
  moyen
  fort
}

/** Fiche entreprise CRM (prospect local, ou enrichissement d’un client Facturation). */
model CrmCompany {
  id             String                @id @default(cuid())
  /// Lien optionnel vers fiche Facturation (jamais écrit depuis Prospection).
  clientId       String?               @unique
  name           String
  kind           CrmCompanyKind        @default(prospect)
  sector         String                @default("")
  size           String                @default("")
  site           CrmSite               @default(libreville)
  address        String                @default("")
  phone          String                @default("")
  email          String                @default("")
  website        String                @default("")
  managerId      String                @default("")
  servicesBought CrmServiceLine[]      @default([])
  targetLines    CrmServiceLine[]      @default([])
  source         CrmOpportunitySource  @default(nouveau)
  strategic      Boolean               @default(false)
  caSigned       Decimal               @default(0) @db.Decimal(18, 2)
  notes          String                @default("")
  /// Plan de compte stratégique (JSON AccountPlan).
  plan           Json?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy     StaffMember?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  activities    CrmActivity[]
  leads         CrmLead[]
  expenses      CrmExpense[]

  @@index([name])
  @@index([kind])
  @@index([site])
  @@index([managerId])
  @@index([createdById])
  @@map("crm_companies")
}

model CrmContact {
  id            String               @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  role          String               @default("")
  phone         String               @default("")
  email         String               @default("")
  decisionMaker Boolean              @default(false)
  influence     CrmContactInfluence  @default(moyen)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([lastName])
  @@map("crm_contacts")
}

model CrmLead {
  id          String         @id @default(cuid())
  companyName String
  companyId   String?
  line        CrmServiceLine
  need        String
  comment     String         @default("")
  ownerId     String
  author      String         @default("")
  status      CrmLeadStatus  @default(nouvelle)
  at          DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company     CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?

  @@index([status])
  @@index([ownerId])
  @@index([companyId])
  @@index([at])
  @@map("crm_leads")
}

model CrmOpportunity {
  id           String                @id @default(cuid())
  companyId    String
  leadId       String?               @unique
  title        String
  line         CrmServiceLine
  source       CrmOpportunitySource
  stage        CrmPipelineStage      @default(qualification)
  amount       Decimal               @default(0) @db.Decimal(18, 2)
  probability  Int                   @default(20)
  decisionOn   DateTime?             @db.Date
  nextAction   String                @default("")
  nextActionOn DateTime?             @db.Date
  ownerId      String
  notes        String                @default("")
  lostReason   String?
  reviveOn     DateTime?             @db.Date
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company    CrmCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       CrmLead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  expenses   CrmExpense[]

  @@index([companyId])
  @@index([stage])
  @@index([ownerId])
  @@index([nextActionOn])
  @@map("crm_opportunities")
}

model CrmActivity {
  id            String            @id @default(cuid())
  companyId     String
  opportunityId String?
  at            DateTime          @db.Date
  time          String?
  kind          CrmActivityKind
  title         String
  summary       String            @default("")
  nextAction    String?
  nextActionOn  DateTime?         @db.Date
  ownerId       String
  status        CrmActivityStatus @default(terminee)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company     CrmCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  expenses    CrmExpense[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([at])
  @@index([ownerId])
  @@index([status])
  @@map("crm_activities")
}

enum CrmExpenseCategory {
  evenements
  relations
  communication
  deplacements
  reserve
}

enum CrmExpenseApproval {
  none
  pending
  approved
  rejected
}

enum CrmObjectiveMetric {
  qualifies
  contacts
  rdv
  propositions
  signatures
}

enum CrmLibraryDomain {
  rh
  comptabilite
  conseil
  fiscalite
  formation
  audit
  juridique
}

enum CrmReferentialKind {
  line
  stage
  site
  expense
  sector
}

model CrmExpense {
  id            String             @id @default(cuid())
  managerId     String
  category      CrmExpenseCategory
  label         String
  amount        Decimal            @db.Decimal(18, 2)
  at            DateTime           @db.Date
  companyId     String?
  opportunityId String?
  activityId    String?
  receipt       Boolean            @default(false)
  approval      CrmExpenseApproval @default(none)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company     CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  activity    CrmActivity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([managerId])
  @@index([at])
  @@index([approval])
  @@index([companyId])
  @@map("crm_expenses")
}

model CrmObjective {
  id        String             @id @default(cuid())
  managerId String
  metric    CrmObjectiveMetric
  target    Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([managerId, metric])
  @@index([managerId])
  @@map("crm_objectives")
}

model CrmLibraryItem {
  id        String           @id @default(cuid())
  line      CrmLibraryDomain
  category  String
  title     String
  body      String
  terms     Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([line])
  @@index([category])
  @@map("crm_library_items")
}

model CrmReferential {
  id        String             @id @default(cuid())
  kind      CrmReferentialKind
  label     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([kind])
  @@map("crm_referentials")
}

model CrmWeekCheck {
  id        String   @id @default(cuid())
  /// Clé stable (ex. wk-1) pour le seed / sync.
  key       String   @unique
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("crm_week_checks")
}

/** Notifications de l’espace Prospection (séparées de celles Facturation). */
model CrmNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  at        DateTime @default(now())
  href      String   @default("/prospection")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read, at])
  @@index([at])
  @@map("crm_notifications")
}
