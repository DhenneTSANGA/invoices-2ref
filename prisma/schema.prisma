generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Cabinet {
  conseil
  expertise_fiscale
}

enum DocumentType {
  quotation
  invoice
  letter
}

enum DocumentStatus {
  draft
  signed
  sent
  accepted
  rejected
  paid
  overdue
  archived
  cancelled
}

enum PaymentMethod {
  cash
  check
  bank_transfer
}

enum ActivityKind {
  invoice_paid
  invoice_sent
  invoice_overdue
  quotation_accepted
  quotation_sent
  client_added
}

enum NotificationType {
  info
  success
  warning
  danger
}

enum MailDirection {
  outbound
  inbound
}

enum DocumentPdfAction {
  download
  email
}

enum StaffRole {
  member
  admin
  super_admin
}

enum AdminRequestStatus {
  pending
  accepted
  rejected
}

enum MailMergeStatus {
  draft
  signed
  sent
}

model Company {
  id          String   @id @default(cuid())
  cabinet     Cabinet  @unique
  name        String
  tagline     String?
  nif         String
  niu         String
  rccm        String
  cnss        String?
  address     String
  city        String
  phone       String
  email       String
  website     String?
  bankName    String?
  bankAccount String?
  /** Adresse From Resend (domaine vérifié). Si vide → email du cabinet. */
  mailFromEmail String?
  /** Reply-To. Si vide → mailFromEmail / email. */
  mailReplyTo   String?
  /** Nom du gérant (signataire des lettres). */
  managerName String?
  /** URL publique du cachet / tampon (Storage ou asset). */
  stampUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

model StaffMember {
  id        String    @id
  email     String    @unique
  firstName String
  lastName  String
  jobTitle  String
  phone     String?
  avatarUrl String?
  role      StaffRole @default(member)
  /// Null uniquement pour super_admin (au-dessus des cabinets).
  cabinet   Cabinet?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents     Document[]
  clients       Client[]
  services      Service[]
  notifications Notification[]
  adminRequests AdminRequest[] @relation("AdminRequestStaff")
  reviewedRequests AdminRequest[] @relation("AdminRequestReviewer")
  pdfTraces     DocumentPdfTrace[]
  mailMergeCampaigns MailMergeCampaign[] @relation("MailMergeCreator")
  mailMergeSigned    MailMergeCampaign[] @relation("MailMergeSigner")

  @@index([lastName])
  @@index([role])
  @@index([cabinet])
  @@map("staff_members")
}

/** Comptes retirés de la plateforme (login → page « compte supprimé »). */
model RevokedAccount {
  id         String   @id @default(cuid())
  email      String   @unique
  authUserId String?
  revokedAt  DateTime @default(now())
  revokedById String?

  @@index([authUserId])
  @@map("revoked_accounts")
}

model AdminRequest {
  id           String             @id @default(cuid())
  staffId      String
  status       AdminRequestStatus @default(pending)
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  staff      StaffMember  @relation("AdminRequestStaff", fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy StaffMember? @relation("AdminRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([staffId, status])
  @@index([status, createdAt])
  @@map("admin_requests")
}

model Client {
  id          String   @id @default(cuid())
  cabinet     Cabinet
  name        String
  legalForm   String
  nif         String
  niu         String
  rccm        String
  contactName String
  email       String
  phone       String
  address     String
  city        String
  country     String   @default("Gabon")
  /** URL publique fiche circuit (Storage). */
  ficheCircuitUrl  String?
  ficheCircuitName String?
  /** URL publique fiche status (Storage). */
  ficheStatusUrl   String?
  ficheStatusName  String?
  /** Collaborateur ayant créé la fiche (null = historique). */
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  createdBy StaffMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([cabinet])
  @@index([name])
  @@index([city])
  @@index([createdById])
  @@map("clients")
}

model Service {
  id          String   @id @default(cuid())
  cabinet     Cabinet
  code        String
  name        String
  description String   @default("")
  unit        String
  unitPrice   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  category    String
  /** Collaborateur ayant créé la prestation (null = historique / seed). */
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     DocumentLine[]
  createdBy StaffMember?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([cabinet, code])
  @@index([cabinet])
  @@index([category])
  @@index([createdById])
  @@map("services")
}

model Document {
  id                String         @id @default(cuid())
  cabinet           Cabinet
  type              DocumentType
  number            String
  clientId          String
  createdById       String
  status            DocumentStatus @default(draft)
  issueDate         DateTime       @db.Date
  dueDate           DateTime       @db.Date
  subtotal          Decimal        @db.Decimal(18, 2)
  tps               Decimal        @default(0) @db.Decimal(18, 2)
  css               Decimal        @default(0) @db.Decimal(18, 2)
  vat               Decimal        @db.Decimal(18, 2)
  total             Decimal        @db.Decimal(18, 2)
  currency          String         @default("XAF")
  notes             String?
  paymentTerms      String?
  /** Moyen de règlement lorsque status = paid. */
  paymentMethod     PaymentMethod?
  validityDays      Int?
  executionTerms    String?
  subject           String?
  salutation        String?
  body              String?
  closing           String?
  signatoryTitle    String?
  recipientOverride String?
  /** Facture modèle d'abonnement mensuel. */
  isSubscription       Boolean   @default(false)
  subscriptionActive   Boolean   @default(false)
  /** Jour du mois d'envoi (1–28). */
  subscriptionDay      Int?
  subscriptionNextAt   DateTime? @db.Date
  /** Facture générée depuis un abonnement (id du modèle). */
  subscriptionOfId     String?
  /** Campagne de publipostage (lettres groupées). */
  mailMergeCampaignId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy     StaffMember    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  subscriptionOf Document?     @relation("SubscriptionGenerations", fields: [subscriptionOfId], references: [id], onDelete: SetNull)
  subscriptionChildren Document[] @relation("SubscriptionGenerations")
  mailMergeCampaign MailMergeCampaign? @relation(fields: [mailMergeCampaignId], references: [id], onDelete: SetNull)
  lines         DocumentLine[]
  notifications Notification[]
  pdfTraces     DocumentPdfTrace[]

  @@unique([cabinet, type, number])
  @@index([cabinet])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([issueDate])
  @@index([isSubscription, subscriptionActive, subscriptionNextAt])
  @@index([subscriptionOfId])
  @@index([mailMergeCampaignId])
  @@map("documents")
}

model DocumentLine {
  id          String  @id @default(cuid())
  documentId  String
  serviceId   String?
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  tpsRate     Decimal @default(0) @db.Decimal(5, 2)
  cssRate     Decimal @default(0) @db.Decimal(5, 2)
  position    Int     @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([serviceId])
  @@map("document_lines")
}

model Activity {
  id          String       @id @default(cuid())
  kind        ActivityKind
  title       String
  description String
  at          DateTime     @default(now())

  @@index([at])
  @@map("activities")
}

model Notification {
  id         String           @id @default(cuid())
  staffId    String
  title      String
  body       String
  at         DateTime         @default(now())
  read       Boolean          @default(false)
  type       NotificationType @default(info)
  documentId String?

  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([staffId, read])
  @@index([staffId, at])
  @@map("notifications")
}

/** Campagne de publipostage lettres (création → signature → envoi). */
model MailMergeCampaign {
  id             String          @id @default(cuid())
  cabinet        Cabinet
  createdById    String
  status         MailMergeStatus @default(draft)
  subject        String
  salutation     String          @default("")
  body           String
  closing        String          @default("")
  signatoryTitle String          @default("Le Gérant")
  issueDate      DateTime        @db.Date
  signedAt       DateTime?
  signedById     String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy StaffMember  @relation("MailMergeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signedBy  StaffMember? @relation("MailMergeSigner", fields: [signedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([cabinet, createdAt])
  @@index([status])
  @@index([createdById])
  @@map("mail_merge_campaigns")
}

/** Historique des e-mails envoyés / reçus (espace Mails). */
model MailMessage {
  id         String        @id @default(cuid())
  cabinet    Cabinet?
  direction  MailDirection
  resendId   String?       @unique
  fromEmail  String
  toEmail    String
  subject    String
  preview    String        @default("")
  htmlBody   String?
  textBody   String?
  documentId String?
  clientId   String?
  staffId    String?
  lastEvent  String?
  createdAt  DateTime      @default(now())

  @@index([cabinet, direction, createdAt])
  @@index([direction, createdAt])
  @@map("mail_messages")
}

/** Trace PDF généré (téléchargement ou envoi e-mail). */
model DocumentPdfTrace {
  id         String            @id @default(cuid())
  documentId String
  cabinet    Cabinet
  action     DocumentPdfAction
  fileName   String
  fileUrl    String
  staffId    String
  createdAt  DateTime          @default(now())

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([cabinet, createdAt])
  @@index([staffId])
  @@map("document_pdf_traces")
}
