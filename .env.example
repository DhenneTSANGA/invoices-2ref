# Prisma + Supabase
# https://supabase.com/docs/guides/database/prisma

# Runtime Prisma Client — Supavisor Transaction mode (port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations — Session pooler (port 5432) de préférence
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Client Supabase (Vite / TanStack Start)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Alias serveur
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Requis pour téléverser les fiches circuit/status clients (bucket Storage « client-fiches », public)
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Resend (envois documents + alertes)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Fallback global si la fiche cabinet n’a pas mailFromEmail (option B = Paramètres)
# RESEND_FROM_EMAIL=expertise.fiscale@2ref.ga
# RESEND_REPLY_TO=expertise.fiscale@2ref.ga
# Préférez Paramètres → Adresse d’envoi / Reply-To par cabinet (domaines 2ref.ga & 2rconseil.ga vérifiés).

# URL publique de l'app (liens dans les e-mails d'alerte + invitations)
# APP_URL=http://localhost:8080

# Bootstrap super admin (emails séparés par des virgules)
SUPER_ADMIN_EMAIL=vous@example.com

# Inscription publique (formulaire /signup + onboarding libre).
# Laisser désactivé en prod : seuls les super admins invitent depuis Équipe.
# PUBLIC_SELF_SIGNUP=true
# VITE_PUBLIC_SELF_SIGNUP=true
